      "anomaly_type": "NONE",
      "expected_decision": "NORMAL",
      "expected_source_health": "HEALTHY",
      "expected_sensor_health_impact": "STABLE",
      "expected_correction_behavior": "NONE",
      "expected_ws_event_type": "OBSERVATION_UPDATED",
      "expected_qc_status": "VALID"
    },
