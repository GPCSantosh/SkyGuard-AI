# ==============================================================================
# SkyGuard AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure as appropriate for your environment.
# NEVER commit .env with production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Environment: development | staging | production | testing
SKYGUARD_ENV=development
SKYGUARD_DEBUG=true
# Log Level: DEBUG | INFO | WARNING | ERROR
SKYGUARD_LOG_LEVEL=INFO
# Log Format: text (human-readable console) | json (structured container log aggregator)
SKYGUARD_LOG_FORMAT=text

# ------------------------------------------------------------------------------
# 2. API & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
SKYGUARD_API_HOST=0.0.0.0
SKYGUARD_API_PORT=8000
SKYGUARD_API_RELOAD=false
SKYGUARD_API_PREFIX=/api/v1
# CORS allowed origins (JSON array or comma-separated list)
SKYGUARD_CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:5173", "http://localhost:3000"]

# Observation Sampling Cadence (Default: 300 seconds / 5 minutes)
SKYGUARD_OBSERVATION_INTERVAL_SECONDS=300

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION & PERSISTENCE
# ------------------------------------------------------------------------------
# SQLite (Local Dev / Testing Default):
SKYGUARD_DATABASE_URL=sqlite:///./data/skyguard_dev.db
# PostgreSQL (Production Target Example):
# SKYGUARD_DATABASE_URL=postgresql://skyguard_user:CHANGE_ME_PASSWORD@postgres:5432/skyguard_ai

# Connection Pool Settings
SKYGUARD_STORAGE_POOL_SIZE=10
SKYGUARD_STORAGE_MAX_OVERFLOW=20
SKYGUARD_STORAGE_POOL_TIMEOUT_SECONDS=30

# Migration Strategy:
# true in local development for auto-bootstrap; set false in production to allow migration runner container to control schema upgrades
SKYGUARD_AUTO_MIGRATE=true

# Data Retention Policies (-1 = retain indefinitely, >0 = retain N days)
SKYGUARD_STORAGE_RAW_PAYLOAD_RETENTION_DAYS=30
SKYGUARD_STORAGE_OBSERVATION_RETENTION_DAYS=-1
SKYGUARD_STORAGE_ANOMALY_RETENTION_DAYS=-1
SKYGUARD_STORAGE_EXPLANATION_RETENTION_DAYS=-1
SKYGUARD_STORAGE_SENSOR_HEALTH_RETENTION_DAYS=-1
SKYGUARD_STORAGE_SOURCE_HEALTH_RETENTION_DAYS=-1
SKYGUARD_STORAGE_OUTAGE_EPISODE_RETENTION_DAYS=-1
SKYGUARD_STORAGE_CORRECTION_RETENTION_DAYS=-1

# ------------------------------------------------------------------------------
# 4. SECRETS & OPERATIONAL SECURITY (SEPARATED FROM CONFIGURATION)
# ------------------------------------------------------------------------------
# Secret key required for administrative / manual triggers (e.g. POST /api/v1/live/poll-now in production)
SKYGUARD_OPERATIONAL_API_KEY=
# Allow unauthenticated /poll-now trigger in production (default: false for security)
SKYGUARD_ENABLE_PUBLIC_POLL_TRIGGER=false

# PostgreSQL Database Credentials (for Docker Compose deploy)
POSTGRES_DB=skyguard_ai
POSTGRES_USER=skyguard_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_POSTGRES_PASSWORD

# ------------------------------------------------------------------------------
# 5. LIVE EXTERNAL WEATHER API INGESTION (PHASE 11 QUALIFIED)
# ------------------------------------------------------------------------------
SKYGUARD_LIVE_SOURCE_ENABLED=false
SKYGUARD_LIVE_SOURCE_PROVIDER=open_meteo
SKYGUARD_LIVE_SOURCE_BASE_URL=https://api.open-meteo.com/v1
# External provider API key (optional for Open-Meteo, required for commercial tiers)
SKYGUARD_LIVE_SOURCE_API_KEY=
SKYGUARD_LIVE_SOURCE_TIMEOUT_SECONDS=10.0
SKYGUARD_LIVE_SOURCE_POLL_INTERVAL_SECONDS=900
SKYGUARD_LIVE_SOURCE_RETRY_LIMIT=3
SKYGUARD_LIVE_SOURCE_PRESSURE_PRODUCT_TYPE=msl
SKYGUARD_LIVE_SOURCE_STALE_THRESHOLD_SECONDS=3600.0
SKYGUARD_LIVE_SOURCE_OUTAGE_CONSECUTIVE_FAILURES=3
SKYGUARD_LIVE_SOURCE_RECOVERY_REQUIRED_SUCCESSES=2

