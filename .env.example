# SkyGuard AI — Environment Configuration Example
# Copy this file to .env and configure as appropriate for your local or production environment.

# Application Environment (development | staging | production | testing)
SKYGUARD_ENV=development
SKYGUARD_DEBUG=true
SKYGUARD_LOG_LEVEL=INFO

# API Server Configuration
SKYGUARD_API_HOST=127.0.0.1
SKYGUARD_API_PORT=8000
SKYGUARD_API_RELOAD=true
SKYGUARD_API_PREFIX=/api/v1

# Observation Sampling Cadence (Default: 300 seconds / 5 minutes)
SKYGUARD_OBSERVATION_INTERVAL_SECONDS=300

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
SKYGUARD_DATABASE_URL=sqlite:///./data/skyguard_dev.db
# PostgreSQL Production Examples:
# SKYGUARD_DATABASE_URL=postgresql://skyguard_user:skyguard_password@localhost:5432/skyguard_ai
# SKYGUARD_DATABASE_URL=postgresql+psycopg2://skyguard_user:skyguard_password@localhost:5432/skyguard_ai
SKYGUARD_STORAGE_POOL_SIZE=10
SKYGUARD_STORAGE_MAX_OVERFLOW=20
SKYGUARD_STORAGE_AUTO_MIGRATE=true

# Retention Policies (-1 = retain indefinitely)
SKYGUARD_STORAGE_OBSERVATION_RETENTION_DAYS=-1
SKYGUARD_STORAGE_RAW_PAYLOAD_RETENTION_DAYS=-1
SKYGUARD_STORAGE_ANOMALY_RETENTION_DAYS=-1
SKYGUARD_STORAGE_HEALTH_RETENTION_DAYS=-1

# Paths
SKYGUARD_CONFIG_DIR=configs
SKYGUARD_DATA_DIR=data
SKYGUARD_MODELS_DIR=models/registry

# External Live AWS / Weather API Source (Phase 11 Qualification)
SKYGUARD_LIVE_SOURCE_ENABLED=false
SKYGUARD_LIVE_SOURCE_PROVIDER=open_meteo
SKYGUARD_LIVE_SOURCE_BASE_URL=https://api.open-meteo.com/v1
SKYGUARD_LIVE_SOURCE_API_KEY=
SKYGUARD_LIVE_SOURCE_TIMEOUT_SECONDS=10.0
SKYGUARD_LIVE_SOURCE_POLL_INTERVAL_SECONDS=900
SKYGUARD_LIVE_SOURCE_RETRY_LIMIT=3
SKYGUARD_LIVE_SOURCE_PRESSURE_PRODUCT_TYPE=msl

# MQTT Broker (Placeholder for future phases)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=skyguard/aws/

