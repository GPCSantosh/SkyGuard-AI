# ==============================================================================
# SkyGuard AI — Production Frontend Dockerfile
# Multi-stage Node 20-alpine build to Nginx alpine static delivery
# ==============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency specifications
COPY frontend/package.json frontend/package-lock.json* ./

# Install dependencies deterministically
RUN npm ci || npm install

# Copy source code and build config
COPY frontend/ ./

# Build production static bundle (Vite + TypeScript)
RUN npm run build

# ------------------------------------------------------------------------------
# Final Runtime Stage: Nginx Alpine
# ------------------------------------------------------------------------------
FROM nginx:1.25-alpine AS runtime

# Remove default nginx html files
RUN rm -rf /usr/share/nginx/html/*

# Copy built static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx configuration for reverse proxy and SPA routing
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80

# Health check probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/health/live || exit 1

# Default command starts nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
